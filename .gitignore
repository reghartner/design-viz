__pycache__/
*.pyc
*.agent.transcript.jsonl
*.agent.usage.json
.flowview-pilot/
.DS_Store
.manifest.lock
.*.page-build-prev.json

# Local-only agent guidance: CLAUDE.md and the ENTIRE docs/agents/ tree are
# local-only by design and never committed
/CLAUDE.md
/docs/agents/
node_modules/
/.local/
/apps/confluence/static/
/apps/confluence/preview/
/apps/backstage/release/
# npm pack ./apps/backstage writes its distribution to the repository root.
/flowview-backstage-plugin-*.tgz

# Generated from reviewed specs under docs/diagrams on each build.
/workbench/diagrams.json

# Portable entrypoints are built locally and in CI/deployment, never committed.
/template/flowview.html
/workbench/flowspec.html

# Runtime bundles are generated before tests/packaging; authored inputs stay in src/.
/apps/backstage/src/generated/
/tools/canon/generated-runtime.cjs

# Local captures from the pre-promotion arrangement experiment.
/tools/arrange-experimental/artifacts/

# Generated static library screenshots.
/workbench/library-thumbnails/

# Cloudflare static deploy (deploy/cloudflare/deploy.sh): only the three files
# below are tracked. Local settings, generated config, upload output and
# Wrangler state stay out of git. tests/cloudflare-deploy.test.js enforces it.
/deploy/cloudflare/*
!/deploy/cloudflare/README.md
!/deploy/cloudflare/deploy.sh
!/deploy/cloudflare/local.env.example
# Wrangler files created by accident at the repository root.
/wrangler.json
/wrangler.jsonc
/wrangler.toml
/.dev.vars*
# Cloudflare CLI caches, written into whatever directory the command runs in.
# .cloudflare/cache/ holds the account ID and account name.
.cloudflare/
.wrangler/

# AWS build/deployment output and account-specific configuration.
/.aws-sam/
/deploy/aws/.aws-sam/
/deploy/aws/cloud-config.json
/deploy/aws/samconfig.toml
/deploy/aws/dist/
