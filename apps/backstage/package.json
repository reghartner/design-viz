{
  "name": "@flowview/backstage-plugin",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./reference-proxy": {
      "import": {
        "types": "./dist/reference-proxy.d.ts",
        "default": "./dist/reference-proxy.js"
      },
      "require": {
        "types": "./dist/reference-proxy.d.cts",
        "default": "./dist/reference-proxy.cjs"
      }
    },
    "./new-frontend": {
      "import": {
        "types": "./dist/new-frontend.d.ts",
        "default": "./dist/new-frontend.js"
      },
      "require": {
        "types": "./dist/new-frontend.d.cts",
        "default": "./dist/new-frontend.cjs"
      }
    },
    "./backend": {
      "import": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      },
      "require": {
        "types": "./dist/backend.d.cts",
        "default": "./dist/backend.cjs"
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --project tsconfig.host.json",
    "test": "vitest run",
    "verify": "npm run check && npm test",
    "build:viewer": "node build-viewer.mjs",
    "check:viewer": "node build-viewer.mjs --check",
    "preview:build": "node preview.mjs",
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/core-plugin-api": "^1.12.10"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@backstage/catalog-model": "1.10.1",
    "@backstage/frontend-plugin-api": "0.18.1",
    "@backstage/plugin-catalog-react": "3.2.3",
    "@backstage/core-plugin-api": "1.12.10",
    "rollup": "4.63.4",
    "rollup-plugin-dts": "6.5.1"
  },
  "configSchema": "config.d.ts",
  "description": "Native Flowview diagrams for React and Backstage, with optional proxy and frontend adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reghartner/design-viz.git",
    "directory": "apps/backstage"
  },
  "module": "./dist/index.js",
  "files": [
    "dist",
    "config.d.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "@backstage/catalog-model": {
      "optional": true
    },
    "@backstage/frontend-plugin-api": {
      "optional": true
    },
    "@backstage/plugin-catalog-react": {
      "optional": true
    },
    "@backstage/core-plugin-api": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  }
}
