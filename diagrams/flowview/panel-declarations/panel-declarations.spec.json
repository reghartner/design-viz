               "id": "p",
               "cells": {
                "key": "panels.log",
                "value": "{\"log\": [\"first line\"]}",
                "rule": "log lines append"
               }
              },
              {
               "id": "g",
               "cells": {
                "key": "panels.gauge",
                "value": "(no patch)",
                "rule": "keeps the carried value 40"
               }
              }
             ]
            }
           }
          },
          {
           "id": "t-once",
