              },
              {
               "id": "gauge.max",
               "cells": {
                "key": "gauge.max",
                "value": "400 (declaration)",
                "rule": "fixed: no step can change it"
               }
              }
             ]
            }
           }
          },
          {
           "id": "t-carry",
           "edges": [
            "step->path",
            "path->fold",
            "fold->player",
            "player->render"
           ],
           "time": "+1h",
           "text": "**A patch carries forward.** This step writes `{\"value\": 40}` to the gauge. The fold shallow-merges it into the previous snapshot, so 40 stays until another step changes it.",
           "panels": {
            "gauge": {
             "value": 40
            },
            "json": {
             "rows": [
              {
               "id": "p",
               "cells": {
                "key": "panels.gauge",
                "value": "{\"value\": 40}",
                "rule": "shallow merge, carried to later steps"
               }
              }
             ]
            }
           }
          },
          {
           "id": "t-append",
           "edges": [
            "step->path",
            "path->fold",
            "fold->player"
           ],
           "time": "+1h",
           "text": "**Some keys append.** A `log` patch adds lines instead of replacing them. The gauge has no patch at this step, so it keeps 40.",
           "panels": {
            "log": {
             "log": [
              {
               "tag": "STEP",
               "text": "first line"
