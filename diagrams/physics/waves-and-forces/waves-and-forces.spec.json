    "sections": [
      {
        "heading": "01 / When a second wave makes a dark stripe",
        "text": [
          "Can adding a source make a screen darker? Follow two coherent paths from source to probe. The geometry fixes the path difference; wavelength turns that difference into phase. Choose either ending to compare two different interventions at the same dark probe."
        ],
        "bullets": [
          "Distances are in centimetres. The point sources have equal amplitude and emit in phase. The model omits diffraction envelope and geometric spreading; the numbers are illustrative model outputs, not measured light levels."
        ],
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
            "drive": {
              "title": "Coherent drive",
              "sub": "one phase reference",
              "icon": "antenna",
              "tint": "cmd"
            },
            "sources": {
              "title": "Sources S₁ / S₂",
              "sub": "open or close the second path",
              "icon": "sensor",
              "tint": "data"
            },
            "screen": {
              "title": "Screen",
              "sub": "sum amplitudes at each point",
              "icon": "monitor",
              "tint": "dev"
            },
            "probe": {
              "title": "Probe P",
              "sub": "read intensity at y",
              "icon": "chip",
              "tint": "mqtt"
            }
          },
          "rows": [
            [
              "drive",
              "sources",
              "screen",
              "probe"
            ]
          ],
          "edges": [
