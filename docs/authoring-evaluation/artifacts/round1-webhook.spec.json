    "blocks": [
      {
        "heading": "Same topology, three outcomes",
        "accent": "cyan",
        "text": [
          "Sender posts an event to Receiver using HTTPS. Receiver writes to Ledger using SQL and sends an HTTPS acknowledgment to Sender. Missing acknowledgment is shown as a delivery outcome, not as proof that the Ledger write or application failed."
        ],
        "bullets": [
          {
            "text": "**Shared prefix:** all outcomes share the send and the first successful Ledger write."
          },
          {
            "text": "**Retry rule:** Sender retries at most once with the same idempotency key; the actual key value is unspecified."
          },
          {
            "text": "**Lost acknowledgment:** the signal is confirmed lost before reaching Sender; the timeout has no supplied duration."
          },
          {
            "text": "**Recovery effect:** the retry queries Ledger, finds the existing key, and returns an HTTPS acknowledgment without writing or applying again."
          },
          {
            "text": "**Paused recovery:** an operator pauses Sender before its retry, so the retry is not sent and Sender still has no successful acknowledgment."
          }
        ],
        "contract": {
          "title": "On the wire: event post and acknowledgment",
