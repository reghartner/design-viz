          "steps": [
            {
              "id": "ready",
              "text": "The porch is quiet. Camera is active; the resident is inside.",
              "nodes": [
                "camera"
              ]
            },
            {
              "id": "arm",
              "text": "A local schedule starts recording before anyone arrives. No livestream is open.",
              "nodes": [
                "camera"
              ],
              "panels": {
                "home": {
                  "cam": "rec"
                },
                "clip": {
                  "mode": "rec",
                  "scenePlayback": "waiting"
                }
              }
            },
            {
              "id": "approach",
              "text": "A visitor approaches the porch while the camera records.",
              "nodes": [
                "camera"
              ],
              "panels": {
                "home": {
                  "visitor": {
                    "x": 32,
                    "y": 143
                  }
                },
                "clip": {
                  "scenePlayback": "playing"
                },
                "experience": {
                  "state": "Visitor waiting"
                }
              }
            },
            {
              "id": "ring",
              "text": "The visitor presses the doorbell. Camera sends the event to Event Gateway.",
              "edge": "camera->gateway",
              "panels": {
                "home": {
                  "visitor": {
                    "x": 107,
                    "y": 112
                  },
                  "signals": [
                    {
                      "from": "cam",
                      "to": "cloud"
                    }
                  ]
                }
              }
            },
            {
              "id": "authorize",
              "text": "Event Gateway asks Policy whether this device may publish.",
              "edge": "gateway->policy"
            },
            {
              "id": "enrollment",
              "text": "Registry confirms enrollment and permission; Policy allows the event.",
              "edge": "policy->registry",
              "panels": {
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pending"
                    },
                    "cloud": {
                      "status": "pending"
                    },
                    "notified": {
                      "status": "pending"
                    },
                    "viewed": {
                      "status": "pending"
                    }
                  }
                }
              }
            },
            {
              "id": "publish",
              "text": "Policy publishes the clip-processing job to Event Bus.",
              "edge": "policy->bus"
            },
            {
              "id": "consume",
              "text": "Event Bus delivers the job to Clip Worker.",
              "edge": "bus->worker"
            },
            {
              "id": "local-clip",
              "text": "Recording ends. Camera retains the local clip and uploads its bytes to Clip Worker.",
              "edge": "camera->worker",
              "panels": {
                "home": {
                  "cam": "scan",
                  "signals": [
                    {
                      "from": "cam",
                      "to": "cloud"
                    }
                  ]
                },
                "clip": {
                  "mode": "save",
                  "banner": "LOCAL CLIP RETAINED"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "pending"
                    },
                    "notified": {
                      "status": "pending"
                    },
                    "viewed": {
                      "status": "pending"
                    }
                  }
                }
              }
            },
            {
              "id": "persist",
              "text": "Clip Worker stores the clip successfully. Cloud persistence is now confirmed.",
              "edge": "worker->store",
              "panels": {
                "clip": {
                  "banner": "LOCAL + CLOUD CLIP"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "pass"
                    },
                    "notified": {
                      "status": "pending"
                    },
                    "viewed": {
                      "status": "pending"
                    }
                  }
                }
              }
            },
            {
              "id": "schedule",
              "text": "Clip Worker schedules delivery; Notifications adds the item to its outbox.",
              "edge": "worker->notify",
              "panels": {
                "outbox": {
                  "state": "enqueue",
                  "label": "Visitor clip ready",
                  "from": "Clip Worker",
                  "to": "Push Provider",
                  "reason": "Awaiting push submission"
                }
              }
            },
            {
              "id": "push-request",
              "text": "Notifications removes the outbox item and submits it to Push Provider.",
              "edge": "notify->push",
              "panels": {
                "outbox": {
                  "state": "dequeue",
                  "to": "Push Provider",
                  "reason": ""
                }
              }
            },
            {
              "id": "notify-resident",
              "text": "The phone receives \u201cVisitor at the front door.\u201d The resident starts toward the entry.",
              "edge": "push->phone",
              "panels": {
                "resident-phone": {
                  "notify": {
                    "app": "Doorbell",
                    "title": "Visitor at the front door",
                    "text": "Your porch clip is ready."
                  }
                },
                "home": {
                  "signals": [
                    {
                      "from": "cloud",
                      "to": "handset"
                    }
                  ],
                  "resident": {
                    "x": 222,
                    "y": 128
                  }
                },
                "outbox": {
                  "state": "empty"
                },
                "experience": {
                  "state": "Clip ready"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "pass"
                    },
                    "notified": {
                      "status": "pass"
                    },
                    "viewed": {
                      "status": "pending"
                    }
                  }
                }
              }
            },
            {
              "id": "open-clip",
              "text": "The resident opens the notification; the phone requests the saved clip.",
              "edge": "phone->playback",
              "panels": {
                "home": {
                  "resident": {
                    "x": 190,
                    "y": 126
                  }
                }
              }
            },
            {
              "id": "fetch-clip",
              "text": "Playback API authorizes the resident and fetches the stored clip.",
              "edge": "playback->store"
            },
            {
              "id": "view-clip",
              "text": "The phone receives the authorized clip. The resident sees the recorded porch approach.",
              "edge": "playback->phone",
              "panels": {
                "clip": {
                  "banner": "SAVED CLIP \u00b7 RESIDENT VIEW"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "pass"
                    },
                    "notified": {
                      "status": "pass"
                    },
                    "viewed": {
                      "status": "pass"
                    }
                  }
                }
              }
            },
            {
              "id": "welcome",
              "text": "The resident opens the door. The visitor crosses into the entry.",
              "nodes": [
                "camera",
                "phone"
              ],
              "panels": {
                "home": {
                  "door": "open",
                  "visitor": {
                    "x": 164,
                    "y": 112
                  },
                  "resident": {
                    "x": 182,
                    "y": 143
                  }
                },
                "experience": {
                  "state": "Welcoming"
                }
              }
            },
            {
              "id": "inside",
              "text": "The visitor joins the resident inside; the door closes. The saved clip remains available.",
              "nodes": [
                "camera",
                "phone"
              ],
              "panels": {
                "home": {
                  "door": "closed",
                  "visitor": {
                    "x": 228,
                    "y": 102
                  },
                  "resident": {
                    "x": 264,
                    "y": 132
                  }
                },
                "experience": {
                  "state": "Inside"
                }
              }
            },
            {
              "id": "store-rejected",
              "text": "Clip Worker attempts persistence. Clip Store rejects it before storing bytes and returns HTTP 503.",
              "panels": {
                "home": {
                  "cloud": "alert"
                },
                "experience": {
                  "state": "No cloud clip"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "fail"
                    },
                    "notified": {
                      "status": "skip"
                    },
                    "viewed": {
                      "status": "skip"
                    }
                  },
                  "note": "The rejection occurs before persistence; local retention is unaffected."
                }
              },
              "tone": {
                "store": "alert",
                "worker": "warn"
              },
              "edges": [
                "worker->store",
                "store->worker"
              ]
            },
            {
              "id": "local-only",
              "text": "The workflow stops. The clip remains local; the resident is not notified and the visitor waits outside.",
              "nodes": [
                "camera",
                "worker"
              ],
              "panels": {
                "clip": {
                  "banner": "LOCAL ONLY \u00b7 CLOUD REJECTED"
                }
              }
            },
            {
              "id": "push-delayed",
              "text": "Push Provider returns HTTP 429 before phone delivery. The resident has not been notified.",
              "edge": "push->notify",
              "panels": {
                "home": {
                  "cloud": "warn"
                },
                "experience": {
                  "state": "Delivery pending"
                },
                "checkpoints": {
                  "results": {
                    "permitted": {
                      "status": "pass"
                    },
                    "local": {
                      "status": "pass"
                    },
                    "cloud": {
                      "status": "pass"
                    },
                    "notified": {
                      "status": "warn"
                    },
                    "viewed": {
                      "status": "pending"
                    }
                  },
                  "note": "Provider rejected this delivery attempt before forwarding it."
                },
                "outbox": {
                  "state": "empty"
                }
              },
              "tone": {
                "push": "warn"
              }
            },
            {
              "id": "hold-delivery",
              "text": "Notifications holds the delivery for later retry. The cloud clip exists; the visitor is still waiting.",
              "nodes": [
                "notify"
              ],
              "panels": {
                "outbox": {
                  "state": "held",
                  "label": "Visitor clip ready",
                  "reason": "Provider rate limit \u00b7 retry time unspecified",
                  "from": "Notifications",
                  "to": "Push Provider"
                }
              }
            }
          ],
          "paths": [
            {
              "id": "happy",
              "label": "Visitor welcomed",
              "color": "#16a085",
              "steps": [
                "ready",
                "arm",
                "approach",
