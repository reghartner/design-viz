                  "label": "Device permitted"
                },
                {
                  "id": "local",
                  "label": "Local clip retained"
                },
                {
                  "id": "cloud",
                  "label": "Cloud clip stored"
                },
                {
                  "id": "notified",
                  "label": "Resident notified"
                },
                {
                  "id": "viewed",
                  "label": "Clip opened"
