              "title": "Resident experience",
              "states": [
                "Quiet",
                "Visitor waiting",
                "Clip ready",
                "Welcoming",
                "Inside",
                "No cloud clip",
                "Delivery pending"
              ],
              "initial": {
                "state": "Quiet"
              },
              "colors": {
                "Clip ready": "#168669",
                "Inside": "#168669",
                "No cloud clip": "#dc5555",
                "Delivery pending": "#d18a21"
              }
            },
            {
              "id": "resident-phone",
              "type": "phone",
              "title": "Resident notifications"
            },
            {
