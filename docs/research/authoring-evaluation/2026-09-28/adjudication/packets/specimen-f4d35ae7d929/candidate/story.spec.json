              ],
              "text": "1:05 AM. A raccoon crosses the porch. The camera wakes, records a clip of about 20 seconds and uploads it. The clip is sorted as an **animal**: it is saved to the app's timeline, and by default animals do **not** send an alert, so the resident sleeps on.",
              "panels": {
                "batt": {
                  "charge": 25,
                  "note": "held at 25%: story times and usage figures disagree"
                }
              }
            },
            {
              "id": "lowbatt",
              "time": "2026-10-02T04:00",
              "edges": [
                "cam->router",
                "router->ingest",
                "ingest->shadow",
                "shadow->notify",
                "notify->push",
                "push->app"
              ],
              "codeRefs": [
                {
                  "id": "ingest.heartbeat",
                  "label": "heartbeat route",
