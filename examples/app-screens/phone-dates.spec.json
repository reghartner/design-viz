                {
                  "id": "battery",
                  "label": "Battery",
                  "kind": "battery"
                }
              ],
              "initial": {
                "clock": "9:41",
                "date": "Thu, Sep 24",
                "phoneScreen": "home",
                "battery": {
                  "value": 68,
                  "status": "ready"
                }
              }
            }
          ],
          "steps": [
            {
              "id": "today",
              "text": "Start on Thursday, September 24.",
              "nodes": [
                "app"
              ]
            },
            {
              "id": "tomorrow",
              "text": "A day later: change the date and open Device app.",
              "nodes": [
                "app"
              ],
              "panels": {
                "screens": {
                  "date": "Fri, Sep 25"
