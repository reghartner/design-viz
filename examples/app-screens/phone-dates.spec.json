                "app"
              ],
              "panels": {
                "screens": {
                  "date": "Sat, Sep 26"
                },
                "phone": {
                  "date": "Sat, Sep 26"
                },
                "device": {
                  "date": "Sat, Sep 26",
                  "phoneScreen": "home"
                }
              }
            }
          ],
          "sectionLayout": {
