{
  "page": {
    "title": "Optional phone dates",
    "subtitle": "One authored date field across App screens, Phone and Device app",
    "skin": "daylight",
    "sections": [
      {
        "heading": "Follow the date through the story",
        "text": "Dates are optional text. Advance to change the day, hide every date, then restore it. Device app opens its app on the second step.",
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
