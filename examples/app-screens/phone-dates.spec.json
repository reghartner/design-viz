                  "height": 844,
                  "src": "data:image/png;base64,"
                }
              ],
              "initial": {
                "screen": "home",
                "clock": "9:41",
                "date": "Thu, Sep 24"
              }
            },
            {
              "id": "phone",
              "type": "phone",
              "title": "Phone",
