              "title": "Resident phone",
              "icon": "phone"
            }
          },
          "rows": [
            [
              "app"
            ]
          ],
          "panels": [
            {
              "id": "screens",
              "type": "appscreens",
              "title": "App screens",
              "frame": "phone",
              "screens": [
                {
                  "id": "home",
                  "label": "Home",
                  "alt": "Illustrative Hearth app — Home",
                  "caption": "Illustrative sample. Replace with your exported Figma screen.",
