{
  "page": {
    "title": "Camera publish authorization \u2014 CloudWatch example",
    "subtitle": "Exact-topic refused publishes and separate-account queue traffic. Configure QA and production SQS before querying those signals. Replace the illustrative QueueName with the real queue name; no live verification.",
    "tracking": {
      "telemetry": {
        "window": "24h",
        "environment": "stg",
        "grafana": {
          "cloudwatch": "f448f9ed-b858-4637-bcf7-d1c1b4895e97"
        },
        "environments": {
          "qa": {
            "variables": {}
          },
          "stg": {
            "variables": {
              "iotAccount": "646998985045",
              "queueAccount": "551960222585"
            }
          },
          "prd": {
            "variables": {
              "iotAccount": "139648982912",
              "snsAccount": "970642438387"
            }
          }
        }
      }
    },
    "sections": [
      {
        "id": "publish",
        "title": "Exact-topic failures and queue delivery",
        "diagram": {
          "nodes": {
            "device": {
              "title": "Camera device"
            },
            "iot": {
              "title": "AWS IoT",
              "telemetry": {
                "kind": "call",
                "signals": {
                  "refused": {
                    "cloudwatchLogs": {
                      "logGroups": [
                        "arn:aws:logs:us-east-1:${iotAccount}:log-group:AWSIotLogsV2"
                      ],
                      "query": "filter eventType = \"Publish-In\" and status = \"Failure\" and reason = \"AUTHORIZATION_FAILURE\" and topicName = \"$aws/rules/camera_message_power_state\" | stats count() as n",
                      "region": "us-east-1",
                      "valueField": "n"
                    },
                    "unit": "refused publishes",
                    "scope": "topic $aws/rules/camera_message_power_state \u00b7 account ${iotAccount}"
                  }
                }
              }
            },
            "queue": {
              "title": "Staging SQS",
              "telemetry": {
                "kind": "call",
                "signals": {
                  "rate": {
                    "cloudwatch": {
                      "namespace": "AWS/SQS",
                      "metric": "NumberOfMessagesSent",
                      "dimensions": {
                        "QueueName": "camera_message_power_state_${env}"
                      },
                      "statistic": "Sum",
                      "region": "us-east-1",
                      "accountId": "${queueAccount}"
                    },
                    "unit": "messages"
                  }
                }
              }
            }
          },
          "rows": [
            [
              "device",
              "iot",
              "queue"
            ]
          ],
          "edges": [
            {
              "from": "device",
              "to": "iot",
              "label": "Publish authorization",
              "telemetry": {
                "kind": "call",
                "signals": {
                  "refused": {
                    "cloudwatchLogs": {
                      "logGroups": [
                        "arn:aws:logs:us-east-1:${iotAccount}:log-group:AWSIotLogsV2"
                      ],
                      "query": "filter eventType = \"Publish-In\" and status = \"Failure\" and reason = \"AUTHORIZATION_FAILURE\" and topicName = \"$aws/rules/camera_message_power_state\" | stats count() as n",
                      "region": "us-east-1",
                      "valueField": "n"
                    },
                    "unit": "refused publishes",
                    "scope": "topic $aws/rules/camera_message_power_state \u00b7 account ${iotAccount}"
                  }
                }
              }
            },
            {
              "from": "iot",
              "to": "queue",
              "label": "Queue ingress",
              "telemetry": {
                "kind": "call",
                "signals": {
                  "rate": {
                    "cloudwatch": {
                      "namespace": "AWS/SQS",
                      "metric": "NumberOfMessagesSent",
                      "dimensions": {
                        "QueueName": "camera_message_power_state_${env}"
                      },
                      "statistic": "Sum",
                      "region": "us-east-1",
                      "accountId": "${queueAccount}"
                    },
                    "unit": "messages"
                  }
                }
              }
            }
          ],
          "panels": [
            {
              "type": "live-status",
              "title": "Live evidence",
              "id": "proof"
            }
          ]
        }
      }
    ]
  }
}
