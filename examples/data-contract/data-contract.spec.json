          {"id": "validate", "text": "Read the amount and its currency together.", "panels": {"contract": {"highlights": {"total": {"color": "amber", "label": "Validate together"}, "currency": {"color": "amber", "label": "Validate together"}}, "note": "Both fields are required to interpret the payment amount."}}},
