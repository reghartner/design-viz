                    "powerIcon": [],
                    "batteryIcon": [
                      {
                        "icon": "battery"
                      }
                    ]
                  }
                },
                {
                  "id": "low",
                  "label": "Low battery",
                  "cells": {
                    "source": "Battery",
                    "charge": "10%",
                    "charging": false,
                    "powerIcon": [],
                    "batteryIcon": [
                      {
                        "icon": "battery-low"
                      }
                    ]
                  }
                }
              ],
              "initial": {
                "active": "solar"
              }
            }
          ],
          "steps": [
            {
              "id": "solar",
              "text": "Separate Power icon and Battery icons columns show independent UX outputs.",
              "panels": {
                "power": {
                  "note": "Illustrative UX mapping; properties and icons are authored independently."
                }
              }
            },
            {
              "id": "mains",
              "text": "Mains power shows the plug and full-battery icons.",
              "panels": {
                "power": {
                  "active": "mains"
                }
              }
            },
            {
              "id": "carried",
              "text": "The selected case carries forward.",
              "panels": {
                "power": {
                  "note": "The mains case stays highlighted until another case is selected."
                }
              }
            },
            {
              "id": "battery",
              "text": "Battery operation has its own authored icon.",
              "panels": {
                "power": {
                  "active": "battery"
                }
              }
            },
            {
              "id": "low",
              "text": "The alternate path highlights a low-battery warning.",
              "panels": {
                "power": {
                  "active": "low"
                }
              }
            },
            {
              "id": "overview",
              "text": "Clear the highlight to compare every combination.",
              "panels": {
                "power": {
                  "active": null
                }
              }
            }
