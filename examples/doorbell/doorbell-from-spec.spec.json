              "edge": "sentry->relay",
              "lane": "NET",
              "text": "Sentry LP publishes the motion event over MQTT",
              "link": "https://github.com/doorbuzz-cloud/chime/blob/main/fw/sentry/mqtt.c#L61",
              "panels": {
                "leds": {
                  "radio": "tx"
