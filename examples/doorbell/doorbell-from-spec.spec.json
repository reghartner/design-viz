            },
            "relay": {
              "title": "Relay Broker",
              "sub": "MQTT · TLS :8883",
              "icon": "antenna",
              "tint": "mqtt"
            },
            "pulse": {
              "title": "Pulse Events",
              "sub": "event service",
              "icon": "cloud",
              "tint": "cmd",
              "link": "https://github.com/doorbuzz-cloud/chime/blob/main/services/pulse/handler.go#L88"
            },
            "herald": {
