            },
            {
              "edge": "pulse->phone",
              "lane": "NET",
              "text": "Resident gets the push: camera paused to cool down — the visitor has left",
              "panels": {
                "die": {
                  "value": 73
                },
                "los": {
                  "subject": null
                }
              }
            },
            {
              "nodes": [
                "sentry"
