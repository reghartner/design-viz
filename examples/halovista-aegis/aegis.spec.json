                    { "k": "blob", "v": "\"b64:kJ83…\"", "g": "the wrapped key; opaque to Keyring", "hot": true },
                    { "k": "created", "v": "1757085710", "g": "wrap time; Keyring rejects stale re-wraps" }
                  ]
                },
