                      "initial": {"wifi": {"state": "ok"}, "cloud": {"state": "ok"}}},
                    {"id": "buf", "type": "buffer", "title": "Flash event buffer", "capacity": "60 min", "segments": 12,
                      "initial": {"head": 0, "cells": []}},
                    {"id": "blog", "type": "log", "title": "Device log", "tags": {"DEV": "#38E1FF", "NET": "#4ADE80"}}
                  ],
                  "steps": [
                    {"nodes": ["ap", "conn", "rec"], "text": "The router reboots and Warden's association drops — the connection manager marks the wifi link and cloud session LOST and switches the recorder's output to the flash buffer.",
