  "entrypoints": {
    "standalone": {
      "sources": [
        "compatibility.js",
        "canon.js",
        "validator.js",
        "engine.js",
        "viewer/tour-progress.js",
        "tour.config.js",
        "tour.flowview.js"
      ],
      "boot": "boot.flowview.js",
      "styles": [
        "page",
        "tour",
        "core"
      ],
      "fonts": "all",
      "icons": true
    },
    "workbench": {
      "sources": [
        "compatibility.js",
        "canon.js",
        "validator.js",
        "engine.js",
        "viewer/tour-progress.js",
        "tour.config.js",
        "tour.flowview.js",
        "trace-import.js",
        "confluence.js",
        "builder.workbench.js",
        "panel-picker.workbench.js",
        "clipboard.workbench.js",
        "steps.workbench.js",
        "reuse.workbench.js",
        "workspace.workbench.js",
        "layout.workbench.js",
        "canon.workbench.js",
        "human-guide.workbench.js",
        "library.workbench.js",
        "welcome.workbench.js",
        "workbench/onboarding.js"
      ],
      "boot": "boot.workbench.js",
      "styles": [
        "workbench",
        "tour",
        "core"
      ],
      "fonts": "all",
      "icons": true
    },
    "backend": {
      "sources": [
        "compatibility.js",
        "canon.js",
        "validator.js",
        "workbench/auto-arrange-core.js",
        "core/backend.js"
      ],
      "exports": {
        "compatibility": "FlowviewCompatibility",
        "validateSpec": "validateSpec",
        "viewerRouting": "viewerRouting",
        "autoArrangeCandidates": "autoArrangeCandidates",
        "autoArrangeDiagram": "autoArrangeDiagram"
      },
      "defaultExport": "FlowCanon"
    },
    "native": {
      "sources": [
        "compatibility.js",
        "canon.js",
        "validator.js",
        "engine.js"
      ],
      "styles": [
        "page",
        "core"
      ],
      "fonts": "all",
      "icons": true
    },
    "forge": {
      "sources": [
        "compatibility.js",
        "canon.js",
        "validator.js",
        "engine.js",
        "confluence.js"
      ],
      "exports": {
        "buildConfluenceExport": "buildConfluenceExport",
        "buildConfluenceConfig": "buildConfluenceConfig",
        "confluenceSections": "confluenceSections",
        "confluenceDisplayPage": "confluenceDisplayPage",
        "confluenceSourceUrl": "confluenceSourceUrl",
        "CONFLUENCE_INPUT_BYTES": "CONFLUENCE_INPUT_BYTES",
        "SKIN_NAMES": "SKIN_NAMES",
        "DEFAULT_SKIN": "DEFAULT_SKIN",
        "renderPage": "renderPage",
        "applySkinClasses": "applySkinClasses"
      },
      "styles": [
        "page",
        "core"
      ],
      "fonts": "forge",
      "icons": true
    },
    "compatibility": {
      "sources": [
        "compatibility.js"
      ],
      "exports": {
        "FlowviewCompatibility": "FlowviewCompatibility"
      }
    }
  },
  "assets": {
    "styles": {
      "page": "style.flowview.css",
      "core": "style.core.css",
      "workbench": "style.workbench.css",
      "tour": "style.tour.css"
    },
    "icons": "icons.svg",
    "fonts": "fonts/manifest.json",
    "fontProfiles": [
      "all",
      "forge"
    ],
    "sharedStyles": {
      "core": [
        "viewer/explore.css",
        "icons/library.css",
        "icons/brand.css"
      ],
      "workbench": [
        "workbench/icon-picker.css",
        "workbench/brand.css",
        "workbench/agent-conversation.css",
        "workbench/story-brief.css",
        "workbench/onboarding.css"
      ]
    },
    "iconLibrary": "icons/library.js",
    "autoArrangeWorker": [
      "workbench/vendor/viz-3.31.0.js",
      "workbench/vendor/webcola-3.4.0.js",
      "core/geometry.js",
      "workbench/auto-arrange-core.js",
      "workbench/auto-arrange-worker.js"
    ],
    "autoArrangeNotices": [
      "workbench/vendor/NOTICE.txt",
      "workbench/vendor/Viz-LICENSE",
      "workbench/vendor/Graphviz-COPYING",
      "workbench/vendor/Expat-COPYING",
      "workbench/vendor/WebCola-LICENSE"
    ]
  }
}
