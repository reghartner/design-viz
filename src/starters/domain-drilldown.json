                  "state": "HELD ON DEVICE"
                }
              }
            },
            {
              "id": "storage-failed",
              "text": "Object storage returns a rejection. Recording keeps the local clip available, emits no clip-ready event, and stops this path before notification.",
              "nodes": [
                "recording"
              ],
              "failures": {
                "recording->apps": "blocked"
              },
              "tone": {
                "recording": "alert",
                "apps": "dim"
              },
              "panels": {
                "journey": {
                  "state": "STORAGE REJECTED"
                }
              }
            },
            {
              "id": "push-failed",
              "text": "The push is dropped inside Apps / Notify. The indexed clip remains available, but the resident receives no notification in this path.",
              "nodes": [
                "apps"
              ],
              "tone": {
                "apps": "warn"
              },
              "panels": {
                "journey": {
                  "state": "PUSH LOST"
                }
              }
            }
          ],
          "paths": [
            {
              "id": "happy",
