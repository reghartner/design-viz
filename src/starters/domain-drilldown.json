          "steps": [
            {
              "id": "capture",
              "text": "A visitor presses the doorbell. The device creates an event and retains its clip locally.",
              "nodes": [
                "doorbell"
              ],
              "panels": {
                "journey": {
                  "state": "CAPTURED"
                }
              }
            },
            {
              "id": "handoff",
              "text": "Doorbell hands the event to Connectivity. Its local mailbox owns delivery until the cloud accepts it.",
              "edge": "doorbell->connectivity",
              "panels": {
                "journey": {
                  "state": "QUEUED"
                }
              }
            },
            {
              "id": "online",
              "text": "Connectivity confirms cloud acceptance. Open it to inspect the mailbox and uplink.",
              "nodes": [
                "connectivity"
              ],
              "tone": {
                "connectivity": "ok"
              },
              "panels": {
                "journey": {
                  "state": "CLOUD ACCEPTED"
                }
              }
            },
            {
              "id": "record",
              "text": "Recording receives the accepted event and begins storing the retained clip.",
              "edge": "connectivity->recording",
              "panels": {
                "journey": {
                  "state": "CLIP PENDING"
                }
              }
            },
            {
              "id": "saved",
              "text": "The clip is stored and indexed before Recording publishes clip-ready. Expand Recording for the storage boundary.",
              "nodes": [
                "recording"
              ],
              "tone": {
                "recording": "ok"
              },
              "panels": {
                "journey": {
                  "state": "CLIP READY"
                }
              }
            },
            {
              "id": "dispatch",
              "text": "Apps receives clip-ready and prepares the resident notification.",
              "edge": "recording->apps",
              "panels": {
                "journey": {
                  "state": "PUSH PENDING"
                }
              }
            },
            {
              "id": "notify",
              "text": "The push reaches the resident. This happy path ends with a saved clip and one notification.",
              "nodes": [
                "apps"
              ],
              "tone": {
                "apps": "ok"
              },
              "panels": {
                "journey": {
                  "state": "NOTIFIED"
                },
                "resident": {
                  "notify": {
                    "app": "Doorbell",
                    "title": "Someone is at the door",
                    "text": "Your front-door clip is ready."
                  }
                }
              }
            },
            {
              "id": "offline",
              "text": "The uplink drops inside Connectivity. The mailbox retains the event, and no accepted event is sent to Recording. Open Connectivity to locate the failed send.",
              "nodes": [
                "connectivity"
              ],
              "failures": {
                "connectivity->recording": "blocked"
              },
              "tone": {
                "connectivity": "warn",
                "recording": "dim",
                "apps": "dim"
              },
              "panels": {
