      {
        "id": "delivery-mailbox",
        "heading": "Cloud handoff · mailbox and uplink",
        "accent": "blue",
        "text": [
          "This nested Connectivity detail separates enqueue, waiting, send, and acceptance. Queue state is authored at each beat. A known dropped MQTT send leaves the envelope held on the device; it does not imply a retry has occurred."
        ],
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
            "eventin": {
              "title": "Event in",
              "sub": "from Event ingress",
              "icon": "package",
              "tint": "dev"
            },
            "mailbox": {
              "title": "Mailbox",
              "sub": "retained envelope",
              "icon": "db",
              "tint": "data"
            },
            "uplink": {
              "title": "MQTT client",
              "sub": "device uplink",
              "icon": "antenna",
              "tint": "mqtt"
            },
            "eventout": {
              "title": "Event out",
              "sub": "cloud accepted",
              "icon": "cloud",
              "tint": "cmd"
            }
          },
          "rows": [
            [
              "eventin",
              "mailbox",
              "uplink",
              "eventout"
            ]
          ],
          "edges": [
            {
              "from": "eventin",
              "to": "mailbox",
              "kind": "int",
              "label": "enqueue"
            },
            {
              "from": "mailbox",
              "to": "uplink",
              "kind": "int",
              "label": "send"
            },
            {
              "from": "uplink",
              "to": "eventout",
              "kind": "mqtt",
              "label": "publish"
            }
          ],
          "panels": [
            {
              "id": "pending",
              "type": "queue",
              "title": "Device event mailbox",
              "initial": {
                "state": "empty"
              }
            },
            {
              "id": "delivery",
              "type": "state",
              "title": "Acceptance",
              "states": [
                "WAITING",
                "QUEUED",
                "WAITING FOR LINK",
                "SENDING",
                "ACCEPTED",
                "RETAINED"
              ],
              "initial": {
                "state": "WAITING"
              }
            }
          ],
          "steps": [
            {
              "id": "enqueue",
              "text": "The event is stored in the mailbox before the uplink is used.",
              "edge": "eventin->mailbox",
              "panels": {
                "pending": {
                  "state": "enqueue",
                  "label": "DOORBELL event",
                  "from": "Doorbell event ingress",
                  "to": "Cloud event boundary"
                },
                "delivery": {
                  "state": "QUEUED"
                }
              }
            },
            {
              "id": "hold",
              "text": "The event waits in the mailbox while the client prepares the connection.",
              "nodes": [
                "mailbox"
              ],
              "panels": {
                "pending": {
                  "state": "held",
                  "reason": "Waiting for the MQTT uplink"
                },
                "delivery": {
                  "state": "WAITING FOR LINK"
                }
              }
            },
            {
              "id": "send",
              "text": "The client takes a send attempt. The retained envelope remains until cloud acceptance.",
              "edge": "mailbox->uplink",
              "panels": {
                "pending": {
                  "reason": "Waiting for cloud acceptance"
                },
                "delivery": {
                  "state": "SENDING"
                }
              }
            },
            {
              "id": "delivered",
              "text": "The publish is accepted by the cloud. The event leaves the mailbox and crosses Connectivity’s output boundary.",
              "edge": "uplink->eventout",
              "tone": {
                "eventout": "ok"
              },
              "panels": {
                "pending": {
                  "state": "dequeue"
                },
                "delivery": {
                  "state": "ACCEPTED"
                }
              }
            },
            {
              "id": "lost",
              "text": "The MQTT publish is attempted but drops before cloud delivery. The event remains held, with no retry shown.",
              "nodes": [
                "uplink"
              ],
              "failures": {
                "uplink->eventout": "dropped"
              },
              "tone": {
                "uplink": "warn",
                "eventout": "dim"
              },
              "panels": {
                "pending": {
                  "state": "held",
                  "reason": "Uplink dropped; retained on device"
                },
                "delivery": {
                  "state": "RETAINED"
                }
              }
            }
          ],
          "paths": [
            {
              "id": "happy",
              "label": "Accepted",
              "color": "#38bdf8",
              "steps": [
                "enqueue",
                "hold",
                "send",
                "delivered"
              ]
            },
            {
              "id": "link-lost",
              "label": "Uplink lost",
              "color": "#fb923c",
              "steps": [
                "enqueue",
                "hold",
                "send",
                "lost"
              ]
            }
          ]
        },
        "detailOnly": true
      },
      {
        "id": "recording",
        "heading": "Recording · durable clip before publication",
        "accent": "violet",
        "text": [
          "Input: a cloud-accepted event. Output: clip-ready after storage and indexing. The storage-rejected branch receives an HTTP error response, so that response is an ordinary edge. Only the unpublished clip-ready handoff is marked blocked."
        ],
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
            "eventin": {
              "title": "Event in",
              "sub": "from Connectivity",
              "icon": "antenna",
              "tint": "mqtt"
            },
            "writer": {
              "title": "Clip writer",
              "sub": "fetch retained clip",
              "icon": "server",
              "tint": "cmd"
            },
            "objects": {
              "title": "Object store",
              "sub": "durable clip",
              "icon": "db",
              "tint": "data"
            },
            "catalog": {
              "title": "Clip catalog",
              "sub": "index playable clip",
              "icon": "db",
              "tint": "data"
            },
            "eventout": {
              "title": "Clip-ready out",
              "sub": "to Apps / Notify",
              "icon": "package",
              "tint": "cmd"
            }
          },
          "rows": [
            [
              "eventin",
              "writer",
              "objects"
            ],
            [
              "catalog",
              "eventout"
            ]
          ],
          "edges": [
            {
              "from": "eventin",
              "to": "writer",
              "kind": "int",
              "label": "event"
            },
            {
              "from": "writer",
              "to": "objects",
              "kind": "https",
              "label": "PUT"
            },
            {
              "from": "objects",
              "to": "writer",
              "kind": "https",
              "label": "status",
              "ret": true
            },
            {
              "from": "objects",
              "to": "catalog",
              "kind": "int",
              "label": "index"
            },
            {
              "from": "catalog",
              "to": "eventout",
              "kind": "int",
              "label": "ready"
            }
          ],
          "panels": [
            {
              "id": "clip",
              "type": "state",
              "title": "Cloud recording",
              "states": [
                "NOT STARTED",
                "WRITING",
                "STORED",
                "INDEXED",
                "READY",
                "REJECTED"
              ],
              "initial": {
                "state": "NOT STARTED"
              }
            },
            {
              "id": "local",
              "type": "state",
              "title": "Device clip",
              "states": [
                "RETAINED"
              ],
              "initial": {
                "state": "RETAINED"
              }
            }
          ],
          "steps": [
            {
              "id": "accept",
              "text": "Recording accepts the event. The source clip is still retained on the doorbell.",
              "edge": "eventin->writer",
              "panels": {
                "clip": {
                  "state": "WRITING"
                },
                "local": {
                  "state": "RETAINED"
                }
              }
            },
            {
              "id": "write",
              "text": "Clip writer submits the retained media to object storage.",
              "edge": "writer->objects"
            },
            {
              "id": "stored",
              "text": "Storage confirms the object is durable.",
              "nodes": [
                "objects"
              ],
              "tone": {
                "objects": "ok"
              },
              "panels": {
                "clip": {
                  "state": "STORED"
                }
              }
            },
            {
              "id": "indexed",
              "text": "The clip catalog indexes the durable object so the app can resolve it.",
              "edge": "objects->catalog",
              "panels": {
                "clip": {
                  "state": "INDEXED"
                }
              }
            },
            {
              "id": "publish",
              "text": "Recording publishes clip-ready only after the catalog entry exists.",
              "edge": "catalog->eventout",
              "tone": {
                "eventout": "ok"
              },
              "panels": {
                "clip": {
                  "state": "READY"
                }
              }
            },
            {
              "id": "rejected",
              "text": "Storage returns HTTP 503 to the writer. No catalog entry or clip-ready event is created; the retained device clip remains available.",
              "edge": "objects->writer",
              "failures": {
                "catalog->eventout": "blocked"
              },
              "tone": {
                "writer": "alert",
                "objects": "warn",
                "catalog": "dim",
                "eventout": "dim"
              },
              "panels": {
                "clip": {
                  "state": "REJECTED"
                }
              }
            }
          ],
          "paths": [
            {
              "id": "happy",
              "label": "Stored + indexed",
              "color": "#38bdf8",
              "steps": [
                "accept",
                "write",
                "stored",
                "indexed",
                "publish"
              ]
            },
            {
              "id": "storage-rejected",
              "label": "Storage rejected",
              "color": "#a78bfa",
              "steps": [
                "accept",
                "write",
                "rejected"
              ]
            }
          ]
        },
        "detailOnly": true
      },
      {
        "id": "apps-notifications",
        "heading": "Apps · notify after the clip is ready",
        "accent": "pink",
        "text": [
          "Input: clip-ready from Recording. The example assumes the resident has enabled doorbell alerts. The happy path delivers one notification; the alternate is a known dropped push. Neither path changes whether the recorded clip exists."
        ],
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
            "eventin": {
              "title": "Clip-ready in",
              "sub": "from Recording",
              "icon": "package",
              "tint": "data"
            },
            "policy": {
