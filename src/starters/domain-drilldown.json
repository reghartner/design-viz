      {
        "id": "connectivity",
        "heading": "Connectivity · accepted event boundary",
        "accent": "cyan",
        "text": [
          "Input: a doorbell event with a locally retained clip. Output: an event accepted by the cloud. The handoff node contains another detail flow: open it to see the mailbox and the exact send that fails. The held event has no authored recovery in this example."
        ],
        "diagram": {
          "view": "step",
          "autoplay": false,
          "nodes": {
            "eventin": {
              "title": "Event in",
              "sub": "from Doorbell",
              "icon": "chip",
              "tint": "dev"
            },
            "ingress": {
              "title": "Event ingress",
              "sub": "validate + accept",
              "icon": "shield",
              "tint": "auth"
            },
            "handoff": {
              "title": "Cloud handoff",
              "sub": "mailbox + uplink",
              "icon": "antenna",
              "tint": "mqtt",
              "detail": {
                "section": "delivery-mailbox",
                "mode": "focus",
                "path": "happy",
                "step": "enqueue",
                "ports": {
                  "in": "eventin",
                  "out": "eventout"
                },
                "stepMap": {
                  "accept": {
                    "step": "enqueue",
                    "path": "happy"
                  },
                  "queued": {
                    "step": "hold",
                    "path": "happy"
                  },
                  "released": {
                    "step": "delivered",
                    "path": "happy"
                  },
                  "lost": {
                    "step": "lost",
                    "path": "link-lost"
                  }
                }
              }
            },
            "eventout": {
              "title": "Event out",
              "sub": "to Recording",
              "icon": "server",
              "tint": "data"
            }
          },
          "rows": [
            [
              "eventin",
              "ingress",
              "handoff",
              "eventout"
            ]
          ],
          "edges": [
            {
              "from": "eventin",
              "to": "ingress",
              "kind": "int",
              "label": "event"
            },
            {
              "from": "ingress",
              "to": "handoff",
              "kind": "int",
              "label": "queue"
            },
            {
              "from": "handoff",
              "to": "eventout",
              "kind": "int",
              "label": "accepted"
            }
          ],
          "panels": [
            {
              "id": "status",
              "type": "state",
              "title": "Delivery guarantee",
              "states": [
                "WAITING",
                "ACCEPTED LOCALLY",
                "QUEUED",
                "CLOUD ACCEPTED",
                "RETAINED LOCALLY"
              ],
              "initial": {
                "state": "WAITING"
              }
            }
          ],
          "steps": [
            {
              "id": "accept",
              "text": "The domain accepts the device event. Local acceptance does not prove cloud delivery.",
              "edge": "eventin->ingress",
              "panels": {
                "status": {
                  "state": "ACCEPTED LOCALLY"
                }
              }
            },
            {
              "id": "queued",
              "text": "The event enters the cloud handoff mailbox. Open Cloud handoff to inspect its queue state.",
              "edge": "ingress->handoff",
              "panels": {
                "status": {
                  "state": "QUEUED"
                }
              }
            },
            {
              "id": "released",
              "text": "Cloud acceptance releases the event to Recording and removes it from the local mailbox.",
              "edge": "handoff->eventout",
              "tone": {
                "handoff": "ok",
                "eventout": "ok"
              },
              "panels": {
                "status": {
                  "state": "CLOUD ACCEPTED"
                }
              }
            },
            {
              "id": "lost",
              "text": "The MQTT uplink send drops inside Cloud handoff. The event stays in the mailbox; nothing crosses the output boundary.",
