{
  "page": {
    "title": "A home, two outcomes",
    "skin": "pastel",
    "sections": [
      {
        "heading": "A visitor at the door",
        "text": [
          "Start with the place and the people. Switch between Home and Data flow to follow the same step from either perspective. In the workbench, select a step to change devices, place the visitor, or add a local signal."
        ],
        "diagram": {
          "primaryPanel": "home",
          "view": "step",
          "routing": "lanes",
          "nodes": {
            "camera": {
              "title": "Porch camera",
              "icon": "camera",
              "tint": "dev"
            },
            "hub": {
              "title": "Home hub",
              "icon": "antenna",
              "tint": "mqtt"
            },
            "cloud": {
              "title": "Event service",
              "icon": "cloud",
              "tint": "cmd"
            },
            "phone": {
              "title": "Home app",
              "icon": "phone",
              "tint": "data"
            }
          },
          "rows": [
            [
              "camera",
              "hub"
            ],
            [
              "cloud",
              "phone"
            ]
          ],
          "edges": [
            {
              "from": "camera",
              "to": "hub",
              "kind": "mqtt",
              "label": "local detection"
            },
            {
              "from": "hub",
              "to": "cloud",
              "kind": "https",
              "label": "upload event"
            },
            {
              "from": "cloud",
              "to": "phone",
              "kind": "https",
              "label": "notify resident"
            }
          ],
          "panels": [
            {
              "id": "home",
              "type": "homemap",
              "title": "The home",
              "outline": {
                "w": 300,
                "h": 164
              },
              "rooms": [
                {
                  "label": "PORCH",
                  "x": 10,
                  "y": 8,
                  "w": 65,
                  "h": 164
                },
                {
                  "label": "ENTRY",
                  "x": 75,
                  "y": 8,
                  "w": 75,
                  "h": 164
                },
                {
                  "label": "LIVING ROOM",
                  "x": 150,
                  "y": 8,
                  "w": 160,
                  "h": 164
                }
              ],
              "devices": [
                {
                  "id": "cam",
                  "kind": "camera",
                  "label": "Porch cam",
                  "x": 40,
                  "y": 42,
                  "facing": 70,
                  "spread": 60,
                  "range": 72
                },
                {
                  "id": "door",
                  "kind": "entry",
                  "label": "Front door",
                  "x": 102,
                  "y": 90
                },
                {
                  "id": "hub",
                  "kind": "hub",
                  "label": "Home hub",
                  "x": 205,
                  "y": 58
                },
                {
                  "id": "motion",
                  "kind": "sensor",
                  "label": "Motion",
                  "icon": "gear",
                  "x": 262,
                  "y": 130
                }
              ],
              "subjects": [
                {
                  "id": "visitor",
                  "label": "Visitor",
                  "x": 35,
                  "y": 130
                }
              ],
              "initial": {
                "cam": "scan",
                "door": "closed",
                "hub": "idle",
                "motion": "ok"
              }
            },
            {
              "id": "outcome",
              "type": "state",
              "title": "What the resident knows",
              "states": [
                "Quiet",
                "Motion detected",
                "Uploading",
                "Resident notified",
                "Local recording only"
              ],
              "initial": {
                "state": "Quiet"
              }
            }
          ],
          "steps": [
            {
              "id": "quiet",
              "text": "A quiet home. The camera scans the porch; the door is closed.",
              "nodes": [
                "camera",
                "hub"
              ]
            },
            {
              "id": "detect",
              "edge": "camera->hub",
              "text": "A visitor approaches. The porch camera detects motion and signals the local hub.",
              "panels": {
                "home": {
                  "cam": "detect",
                  "hub": "rx",
                  "visitor": {
                    "x": 56,
                    "y": 113
                  },
                  "signals": [
                    {
                      "from": "cam",
                      "to": "hub"
                    }
                  ]
                },
                "outcome": {
                  "state": "Motion detected"
                }
              }
            },
            {
              "id": "upload",
              "edge": "hub->cloud",
              "text": "The visitor reaches the door. The camera records while the hub uploads the event.",
              "panels": {
                "home": {
                  "cam": "rec",
                  "hub": "tx",
                  "visitor": {
                    "x": 94,
                    "y": 140
                  }
                },
                "outcome": {
                  "state": "Uploading"
                }
              }
            },
            {
              "id": "notify",
              "edge": "cloud->phone",
              "text": "The resident is notified and opens the front door.",
              "panels": {
                "home": {
                  "door": "open",
                  "visitor": {
                    "x": 132,
                    "y": 124
                  }
                },
                "outcome": {
                  "state": "Resident notified"
                }
              }
            },
            {
              "id": "inside",
              "nodes": [
                "hub"
              ],
              "text": "The visitor enters. Local motion sensing remains active; the camera returns to scanning.",
              "panels": {
                "home": {
                  "visitor": {
                    "x": 198,
                    "y": 129
                  },
                  "door": "closed",
                  "cam": "scan",
                  "hub": "rx",
                  "motion": "warn",
                  "signals": [
                    {
                      "from": "motion",
                      "to": "hub"
                    }
                  ]
                }
              }
            },
            {
              "id": "offline",
              "failures": {
                "hub->cloud": "dropped"
              },
              "text": "Internet service is down. Local detection and recording still work, but the resident receives no notification.",
              "panels": {
                "home": {
                  "cam": "rec",
                  "hub": "alert",
                  "visitor": {
                    "x": 94,
                    "y": 140
                  }
                },
                "outcome": {
                  "state": "Local recording only"
                }
              }
            },
            {
              "id": "leave",
              "nodes": [
                "camera"
              ],
              "text": "With no response, the visitor leaves. The door stays closed; the recording remains local.",
              "panels": {
                "home": {
                  "visitor": null,
                  "cam": "scan",
                  "hub": "alert"
                }
              }
            }
          ],
          "paths": [
            {
              "id": "happy",
              "label": "Happy path",
              "color": "#43D98B",
              "steps": [
                "quiet",
                "detect",
                "upload",
                "notify",
                "inside"
              ]
            },
            {
              "id": "offline",
              "label": "Internet down",
              "color": "#E6A044",
              "steps": [
                "quiet",
                "detect",
                "offline",
                "leave"
              ]
            }
          ]
        }
      }
    ]
  }
}
