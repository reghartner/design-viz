              "sub": "send / receive / delete",
              "icon": "package",
              "tint": "data"
            },
            "relay": {
              "title": "Delivery relay",
              "sub": "host + retry policy",
              "icon": "gear"
            },
            "consumer": {
              "title": "Consumer",
              "sub": "same processing work",
              "icon": "server"
            }
