                "camera-view": {
                  "mode": "off",
                  "scenePlayback": "waiting"
                }
              }
            },
            {
              "id": "live",
              "edge": "camera->detector",
              "text": "Live frames show the quiet setting before the event.",
              "panels": {
                "camera-view": {
                  "mode": "live"
                }
              }
            },
            {
              "id": "record",
              "text": "Recording has begun. The scene is still quiet.",
              "panels": {
                "camera-view": {
                  "mode": "rec"
                }
              },
              "nodes": [
                "camera"
              ]
            },
            {
              "id": "event",
              "edge": "detector->phone",
              "text": "A person sprints away from the porch, down the path, and out along the sidewalk. The doorbell is already recording.",
              "panels": {
                "camera-view": {
                  "scenePlayback": "playing"
                }
              }
            },
            {
              "id": "save",
              "nodes": [
