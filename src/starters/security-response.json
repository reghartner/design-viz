          "steps": [
            {
              "id": "armed",
              "text": "The home is armed away. Sensors report healthy; there is no incident and no response request.",
              "nodes": [
                "sensor"
              ],
              "panels": {}
            },
            {
              "id": "detected",
              "text": "The front door reports an opening. The event reaches monitoring; recording starts, but the cause is unverified.",
              "edges": [
                "sensor->intake",
                "intake->monitor"
              ],
              "tone": {
                "monitor": "warn"
              },
              "panels": {
                "home": {
                  "door": "open",
                  "cam": "rec",
                  "hub": "tx",
                  "person": {
                    "x": 94,
                    "y": 126
                  }
                },
                "monitor": {
                  "status": "alarm",
                  "incident": "INC-204 \u00b7 front entry",
                  "assessment": "unverified",
                  "detail": "Door open while armed away. Review required.",
                  "door": {
                    "health": "online",
                    "alarm": "triggered",
                    "detail": "Open while armed away"
                  }
                }
              }
            },
            {
              "id": "review",
              "text": "Morgan acknowledges the alarm and reviews camera evidence. The monitoring decision is still pending.",
              "nodes": [
                "monitor"
              ],
              "panels": {
                "monitor": {
                  "status": "reviewing",
                  "assessment": "reviewing",
                  "detail": "Reviewing the entry event and contacting the resident.",
                  "door": {
                    "health": "online",
                    "alarm": "acknowledged",
                    "detail": "Operator is assessing the event"
                  }
                }
              }
            },
            {
              "id": "verified",
              "text": "In this fictional scenario, the operator confirms an intrusion and sends a response request. The response desk has not assigned a unit yet.",
              "edge": "monitor->dispatch",
              "tone": {
                "monitor": "alert"
              },
              "panels": {
                "monitor": {
                  "status": "verified",
                  "assessment": "verified",
                  "detail": "Intrusion confirmed by the operator in this authored scenario.",
                  "motion": {
                    "health": "online",
                    "alarm": "triggered",
                    "detail": "Movement inside the hall"
                  }
                },
                "response": {
                  "status": "requested",
                  "priority": "urgent",
                  "incident": "INC-204 \u00b7 confirmed intrusion",
                  "detail": "Request received. Awaiting dispatcher assignment."
                },
                "home": {
                  "person": {
                    "x": 174,
                    "y": 122
                  },
                  "motion": "alert"
                }
              }
            },
            {
              "id": "assigned",
              "text": "Avery assigns P-12. The property security team remains available; assignment does not mean either team has arrived.",
              "edge": "dispatch->unit",
              "tone": {
                "dispatch": "ok"
              },
              "panels": {
                "response": {
                  "status": "assigned",
                  "detail": "P-12 accepts the assignment.",
                  "patrol": {
                    "status": "assigned",
                    "eta": "6 min \u00b7 example",
                    "detail": "Assignment accepted"
                  }
                }
              }
            },
            {
              "id": "enroute",
              "text": "P-12 reports en route. The arrival estimate is an authored example, not a live clock or routing calculation.",
              "nodes": [
                "unit"
              ],
              "panels": {
                "response": {
                  "status": "enroute",
                  "detail": "Unit reports travel has begun.",
                  "patrol": {
                    "status": "enroute",
                    "eta": "3 min \u00b7 example",
                    "detail": "Travelling to the front entry"
                  }
                }
              }
            },
            {
              "id": "onscene",
              "text": "P-12 reports arrival. The incident remains verified; an arrival report does not imply that the incident is resolved.",
              "nodes": [
                "unit"
              ],
              "tone": {
                "unit": "ok"
              },
              "panels": {
                "response": {
                  "status": "onscene",
                  "detail": "P-12 reports on scene. Resolution has not been reported.",
                  "patrol": {
                    "status": "onscene",
                    "eta": "Arrived",
                    "detail": "At the front entry"
                  }
                },
                "home": {
                  "cam": "scan",
                  "hub": "idle"
                }
              }
            },
            {
              "id": "false-alarm",
              "text": "The resident confirms an authorized entry. Morgan clears the incident; no response request is sent and no unit is assigned.",
              "nodes": [
                "monitor"
              ],
              "tone": {
                "monitor": "ok"
              },
              "panels": {
                "monitor": {
                  "status": "cleared",
                  "assessment": "false-alarm",
                  "detail": "Resident confirms an authorized arrival.",
                  "door": {
                    "health": "online",
                    "alarm": "clear",
                    "detail": "Authorized entry confirmed"
                  }
                },
                "home": {
                  "door": "closed",
                  "cam": "scan",
                  "person": null
                },
                "response": {
                  "status": "idle",
                  "detail": "No dispatch requested. Monitoring closed the false alarm."
                }
              }
            },
            {
              "id": "dispatch-blocked",
              "text": "The operator confirms the incident, but the response request cannot be delivered. No unit is assigned; the monitoring team must follow its separate escalation process.",
              "failures": {
                "monitor->dispatch": "dropped"
              },
              "tone": {
                "monitor": "alert",
                "dispatch": "warn"
              },
              "panels": {
                "monitor": {
                  "status": "verified",
                  "assessment": "verified",
                  "detail": "Incident confirmed; dispatch delivery failed."
                },
                "response": {
                  "status": "blocked",
                  "priority": "urgent",
                  "incident": "INC-204 \u00b7 handoff failed",
                  "detail": "Request not delivered. No responder acknowledgement or ETA."
                }
              }
            }
