                {
                  "id": "patrol",
                  "label": "Patrol team",
                  "kind": "police",
                  "callsign": "P-12"
                },
                {
                  "id": "backup",
                  "label": "Property security",
                  "kind": "security",
                  "callsign": "S-04"
                }
              ],
              "initial": {
                "status": "idle",
                "priority": "routine",
                "incident": "No request",
                "location": "Cedar House \u00b7 front entry",
                "dispatcher": "Avery \u00b7 response desk",
                "detail": "A sensor alarm alone does not assign a responder.",
                "patrol": {
                  "status": "available",
                  "eta": "",
                  "detail": "Not assigned"
                },
                "backup": {
                  "status": "available",
                  "eta": "",
                  "detail": "Not assigned"
                }
              }
