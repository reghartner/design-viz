{
  "page": {
    "title": "From alarm to response",
    "contract": "1",
    "skin": "pastel",
    "sections": [
      {
        "id": "security-response",
        "heading": "One event. Three possible outcomes.",
        "accent": "cyan",
        "text": "A fictional home-security workflow. Compare a confirmed incident, an authorized entry and a failed dispatch handoff. Sensor evidence, the operator decision and responder progress are authored separately. Switch to At the property for the home or Service flow for backend handoffs.",
        "diagram": {
          "view": "step",
          "autoplay": false,
          "primaryPanel": "home",
          "defaultLayout": "response-room",
          "nodes": {
            "sensor": {
              "title": "Home devices",
              "sub": "report an event",
              "icon": "camera",
              "tint": "dev"
            },
            "intake": {
              "title": "Event intake",
              "sub": "deliver the report",
              "icon": "cloud",
              "tint": "mqtt"
            },
            "monitor": {
              "title": "Monitoring",
              "sub": "assess the incident",
              "icon": "terminal",
              "tint": "data"
            },
            "dispatch": {
              "title": "Dispatch desk",
              "sub": "assign a response",
              "icon": "phone",
              "tint": "cmd"
            },
            "unit": {
              "title": "Responders",
              "sub": "report progress",
              "icon": "phone",
              "tint": "dev"
            }
          },
          "rows": [
            [
              "sensor",
              "intake",
              "monitor",
              "dispatch",
              "unit"
            ]
          ],
          "edges": [
            {
              "from": "sensor",
